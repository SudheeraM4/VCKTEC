rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function approvedMember() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function manager() {
      return approvedMember()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['owner', 'president'];
    }

    function validUpload() {
      return ((request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          && request.resource.size <= 8 * 1024 * 1024)
        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          && request.resource.size <= 50 * 1024 * 1024));
    }

    match /public/{userId}/{fileName=**} {
      allow read: if true;
      allow create, update: if manager() && validUpload();
      allow delete: if manager();
    }

    match /submissions/{userId}/{fileName} {
      allow read: if manager() || (approvedMember() && request.auth.uid == userId);
      allow create: if approvedMember() && request.auth.uid == userId && validUpload()
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update: if false;
      allow delete: if manager();
    }
  }
}
